; Engine configuration file.
; Bobek's Adventure (Project 001, "The Deep Vault") — Godot 4.5 project.
; Input actions are registered at runtime in scripts/autoload/game.gd so they
; stay readable in code (see Game._register_inputs).

config_version=5

[application]

config/name="Bobek's Adventure"
config/description="A small atmospheric dungeon crawler."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=4096
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=true
limits/opengl/max_renderable_lights=160
limits/opengl/max_lights_per_object=12
